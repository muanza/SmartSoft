<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="smartsoft-pu" transaction-type="RESOURCE_LOCAL">
        <description>SmartSoft Multi-Tenant Invoicing System Persistence Unit</description>

        <class>com.smartsoft.entity.Tenant</class>
        <class>com.smartsoft.entity.Parceiro</class>
        <class>com.smartsoft.entity.ParceiroTenant</class>
        <class>com.smartsoft.entity.Licenca</class>
        <class>com.smartsoft.entity.LogValidacaoLicenca</class>
        <class>com.smartsoft.entity.UtilizadorCrm</class>
        <class>com.smartsoft.entity.Banner</class>
        <class>com.smartsoft.entity.ComunicacaoMassa</class>
        <class>com.smartsoft.entity.DestinatarioComunicacao</class>
        <class>com.smartsoft.entity.Utilizador</class>
        <class>com.smartsoft.entity.LogAuditoria</class>
        <class>com.smartsoft.entity.Caixa</class>
        <class>com.smartsoft.entity.MovimentoCaixa</class>
        <class>com.smartsoft.entity.CategoriaProduto</class>
        <class>com.smartsoft.entity.Produto</class>
        <class>com.smartsoft.entity.Stock</class>
        <class>com.smartsoft.entity.MovimentoStock</class>
        <class>com.smartsoft.entity.Factura</class>
        <class>com.smartsoft.entity.LinhaFactura</class>
        <class>com.smartsoft.entity.PagamentoFactura</class>
        <class>com.smartsoft.entity.MetaVenda</class>
        <class>com.smartsoft.entity.RelatorioVenda</class>
        <class>com.smartsoft.entity.LogBackup</class>
        <class>com.smartsoft.entity.LogSincronizacaoCloud</class>
        <class>com.smartsoft.entity.ConfiguracaoEmpresa</class>
        <class>com.smartsoft.entity.Traducao</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- PostgreSQL DataSource (managed by Spring Boot HikariCP) -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Hibernate settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.jdbc.batch_size" value="25"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>

            <!-- Second-level cache (disabled for simplicity) -->
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
